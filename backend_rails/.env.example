# ============================================================
# FORGE BY MODULA PROJECT
# BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================
# Copy this file to .env in backend_rails/ or project root.
# NEVER commit real credentials or secret keys to git.

# Rails runtime environment (development, test, production)
RAILS_ENV=development

# Database connection URL (used in local development and Railway PostgreSQL)
# Local example: postgresql://username:password@127.0.0.1:5432/forge_development
DATABASE_URL=postgresql://localhost:5432/forge_development

# Rails master encryption key (production credentials)
# In production, set this from config/master.key
# RAILS_MASTER_KEY=your_rails_master_key_here

# AI Companion (Owl) Gemini API Key
# Used server-side by Owl to generate reflective thought observations.
# Get an API key at https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend Client Origin (for CORS configuration with credentials)
# Defaults to http://localhost:5173 for local Vite dev server.
# In production, set to your Vercel deployment URL (e.g., https://forge.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173

# Server listening port (default: 3000)
PORT=3000
